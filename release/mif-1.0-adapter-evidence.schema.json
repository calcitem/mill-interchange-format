{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/calcitem/mill-interchange-format/raw/master/release/mif-1.0-adapter-evidence.schema.json",
  "title": "MIF Suite 1.0 independent adapter evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "status",
    "classification",
    "suiteConformance",
    "fullConformance",
    "conversionClaimed",
    "unexplainedDifferences",
    "adapter",
    "mifCommit",
    "implementationCommit",
    "evidenceCommit",
    "suiteJcsSha256",
    "suiteRawSha256",
    "artifactIndexRawSha256",
    "capabilityRawSha256",
    "deterministicReportRawSha256",
    "differentialReportRawSha256",
    "rulesetSemanticDigests",
    "testedClasses",
    "artifacts",
    "verification"
  ],
  "properties": {
    "protocol": { "const": "MIF-SUITE-ADAPTER-EVIDENCE/1" },
    "status": { "const": "suite-bound-evidence" },
    "classification": { "const": "exact-for-tested-domain" },
    "suiteConformance": { "const": true },
    "fullConformance": { "const": false },
    "conversionClaimed": { "const": false },
    "unexplainedDifferences": { "const": 0 },
    "adapter": { "$ref": "#/$defs/identifier" },
    "mifCommit": { "$ref": "#/$defs/commit" },
    "implementationCommit": { "$ref": "#/$defs/commit" },
    "evidenceCommit": { "$ref": "#/$defs/commit" },
    "suiteJcsSha256": { "$ref": "#/$defs/digest" },
    "suiteRawSha256": { "$ref": "#/$defs/digest" },
    "artifactIndexRawSha256": { "$ref": "#/$defs/digest" },
    "capabilityRawSha256": { "$ref": "#/$defs/digest" },
    "deterministicReportRawSha256": { "$ref": "#/$defs/digest" },
    "differentialReportRawSha256": { "$ref": "#/$defs/digest" },
    "rulesetSemanticDigests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "testedClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "deterministicReport", "differentialReport"],
      "properties": {
        "capability": { "$ref": "#/$defs/capability" },
        "deterministicReport": { "$ref": "#/$defs/deterministicReport" },
        "differentialReport": { "$ref": "#/$defs/differentialReport" }
      }
    },
    "verification": {
      "type": "object",
      "minProperties": 1
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@/-]+$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rawSha256", "format"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "rawSha256": { "$ref": "#/$defs/digest" },
        "format": { "const": "MIFCAP/1.0" }
      }
    },
    "deterministicReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rawSha256", "protocol", "configDigest", "summary"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "rawSha256": { "$ref": "#/$defs/digest" },
        "protocol": { "const": "MIF-INTEROP-REPORT/1" },
        "configDigest": { "$ref": "#/$defs/digest" },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "failed"],
          "properties": {
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "differentialReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rawSha256", "protocol", "configDigest", "summary"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "rawSha256": { "$ref": "#/$defs/digest" },
        "protocol": { "const": "MIF-INTEROP-DIFFERENTIAL-REPORT/1" },
        "configDigest": { "$ref": "#/$defs/digest" },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runsPassed",
            "runsFailed",
            "mutationFamiliesPassed",
            "mutationFamiliesFailed"
          ],
          "properties": {
            "runsPassed": { "type": "integer", "minimum": 0 },
            "runsFailed": { "type": "integer", "minimum": 0 },
            "mutationFamiliesPassed": { "type": "integer", "minimum": 0 },
            "mutationFamiliesFailed": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/calcitem/mill-interchange-format/raw/master/release/mif-1.0-release-manifest.schema.json",
  "title": "MIF Suite 1.0 release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "status",
    "release",
    "suite",
    "bindings",
    "implementations",
    "signing"
  ],
  "properties": {
    "format": { "const": "MIF-RELEASE-MANIFEST/1" },
    "status": {
      "enum": ["awaiting-adapter-suite-pin", "ready-for-tag"]
    },
    "release": { "$ref": "#/$defs/release" },
    "suite": { "$ref": "#/$defs/suite" },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/binding" }
    },
    "implementations": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/implementation" }
    },
    "signing": { "$ref": "#/$defs/signing" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "ready-for-tag" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "implementations": {
            "items": { "required": ["suiteEvidenceBinding"] }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@/-]+$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tag",
        "repository",
        "branch",
        "wireCommit",
        "license",
        "compatibilityPolicy"
      ],
      "properties": {
        "id": { "const": "mif-suite-1.0" },
        "tag": { "const": "mif-suite-1.0" },
        "repository": {
          "const": "https://github.com/calcitem/mill-interchange-format.git"
        },
        "branch": { "const": "master" },
        "wireCommit": { "$ref": "#/$defs/commit" },
        "license": { "const": "Apache-2.0" },
        "compatibilityPolicy": { "const": "mif-1x-strict-v1" }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "mif-suite-1.0.json" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "repository", "path", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "role": {
          "enum": [
            "specification",
            "registry",
            "corpus",
            "schema",
            "abnf",
            "conversion",
            "runner",
            "adapter",
            "evidence",
            "policy",
            "license"
          ]
        },
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?$"
        },
        "commit": { "$ref": "#/$defs/commit" },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project",
        "adapter",
        "repository",
        "branch",
        "implementationCommit",
        "artifactBinding"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "project": { "type": "string", "minLength": 1 },
        "adapter": { "$ref": "#/$defs/identifier" },
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?$"
        },
        "branch": { "type": "string", "minLength": 1 },
        "implementationCommit": { "$ref": "#/$defs/commit" },
        "artifactBinding": { "$ref": "#/$defs/identifier" },
        "suiteEvidenceBinding": { "$ref": "#/$defs/identifier" }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism",
        "workflow",
        "tagRef",
        "subjects",
        "verificationCommands"
      ],
      "properties": {
        "mechanism": { "const": "github-sigstore-attestation-v1" },
        "workflow": { "const": ".github/workflows/release.yml" },
        "tagRef": { "const": "refs/tags/mif-suite-1.0" },
        "subjects": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "verificationCommands": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/calcitem/mill-interchange-format/raw/master/interop/schema/adapter-cases-v1.schema.json",
  "title": "MIF interoperability comparison case source v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "cases"],
  "properties": {
    "protocol": { "const": "MIF-INTEROP-CASES/1" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "operation", "comparison", "expectedStatus", "payload"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
          },
          "operation": {
            "enum": [
              "capabilities",
              "canonicalize",
              "execute",
              "project-logical-turns",
              "replay",
              "transform"
            ]
          },
          "comparison": {
            "enum": ["schema-only", "semantic-equality"]
          },
          "expectedStatus": { "enum": ["ok", "error"] },
          "expectedCode": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
          },
          "payload": { "type": "object" }
        }
      }
    }
  }
}

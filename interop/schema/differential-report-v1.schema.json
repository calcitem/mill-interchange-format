{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/calcitem/mill-interchange-format/raw/master/interop/schema/differential-report-v1.schema.json",
  "title": "MIF candidate differential report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "status",
    "suiteConformance",
    "launchDigest",
    "configDigest",
    "adapters",
    "implementations",
    "runs",
    "negativeCases",
    "summary"
  ],
  "properties": {
    "protocol": { "const": "MIF-INTEROP-DIFFERENTIAL-REPORT/1" },
    "status": { "enum": ["passed", "failed"] },
    "suiteConformance": { "const": false },
    "launchDigest": { "$ref": "#/$defs/digest" },
    "configDigest": { "$ref": "#/$defs/digest" },
    "adapters": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "implementations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter", "name", "version", "capabilitiesDigest"],
        "properties": {
          "adapter": { "$ref": "#/$defs/identifier" },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "capabilitiesDigest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/run" }
    },
    "negativeCases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/negative" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runsPassed", "runsFailed", "negativePassed", "negativeFailed"],
      "properties": {
        "runsPassed": { "type": "integer", "minimum": 0 },
        "runsFailed": { "type": "integer", "minimum": 0 },
        "negativePassed": { "type": "integer", "minimum": 0 },
        "negativeFailed": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "requestId",
        "pointer",
        "expected",
        "actual",
        "eventPrefix"
      ],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "requestId": { "$ref": "#/$defs/identifier" },
        "baselineAdapter": { "$ref": "#/$defs/identifier" },
        "candidateAdapter": { "$ref": "#/$defs/identifier" },
        "pointer": { "type": "string" },
        "expected": {},
        "actual": {},
        "eventPrefix": { "type": "array", "items": { "type": "object" } }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "seed",
        "status",
        "stopReason",
        "logicalTurns",
        "eventCount",
        "prngDraws",
        "prngState",
        "coverage",
        "events",
        "eventsDigest",
        "transcriptDigest",
        "finalCurrent",
        "finalDecisionDigest"
      ],
      "properties": {
        "scenario": { "$ref": "#/$defs/identifier" },
        "seed": { "$ref": "#/$defs/hex64" },
        "status": { "enum": ["passed", "failed"] },
        "stopReason": {
          "enum": ["terminal", "logical-turn-limit", "difference", "resource-limit"]
        },
        "logicalTurns": { "type": "integer", "minimum": 0 },
        "eventCount": { "type": "integer", "minimum": 0 },
        "prngDraws": { "type": "integer", "minimum": 0 },
        "prngState": { "$ref": "#/$defs/hex64" },
        "coverage": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "events": { "type": "array", "items": { "type": "object" } },
        "eventsDigest": { "$ref": "#/$defs/digest" },
        "transcriptDigest": { "$ref": "#/$defs/digest" },
        "finalCurrent": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "finalDecisionDigest": {
          "oneOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "failure": { "$ref": "#/$defs/failure" }
      }
    },
    "negative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "status", "expectedCode", "responseDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "family": {
          "enum": [
            "illegal-event",
            "noncanonical-text",
            "digest-envelope-conflict",
            "truncated-history",
            "resource-limit"
          ]
        },
        "status": { "enum": ["passed", "failed"] },
        "expectedCode": { "type": ["string", "null"] },
        "responseDigest": { "type": ["string", "null"] },
        "failure": { "$ref": "#/$defs/failure" }
      }
    }
  }
}
